<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Header & Konfigurasi Server PC -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#1E293B">

        <!-- Baris Judul + Status Badge + Tombol Lipat Pengaturan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EduQR Scanner"
                    android:textColor="#F8FAFC"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCompactServerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi LAN ke Server PC"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum Terhubung"
                android:textColor="#FDE68A"
                android:background="@drawable/bg_badge_warning"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleConfig"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Atur"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0" />
        </LinearLayout>

        <!-- Panel Input Alamat Server & PIN (Bisa dilipat setelah terhubung) -->
        <LinearLayout
            android:id="@+id/layoutServerConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="https://192.168.1.100:8443"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:background="@drawable/bg_input_dark"
                android:paddingHorizontal="12dp"
                android:textSize="13sp"
                android:inputType="textUri"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etPin"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="PIN 4-Digit"
                    android:gravity="center"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:background="@drawable/bg_input_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:inputType="number"
                    android:maxLength="6"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.3"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Hubungkan ke PC"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#10B981"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Baris Kontrol Cepat: Mode Umum/Mapel, Kamera Depan/Belakang, Zoom, Flash -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnModeToggle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.05"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Umum"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSwitchCamera"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.25"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Kamera: Blk"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnZoomToggle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="0.85"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="1.0x"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0" />

            <Button
                android:id="@+id/btnTorch"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="0.85"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Flash"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0" />
        </LinearLayout>

        <!-- Pilihan Mata Pelajaran (Muncul saat Mode Mapel aktif) -->
        <LinearLayout
            android:id="@+id/layoutSubjectRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mapel:"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spSubject"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_dark" />
        </LinearLayout>
    </LinearLayout>

    <!-- Area Kamera Live + Viewfinder Jernih -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <id.eduqr.scanner.ScannerOverlayView
            android:id="@+id/scannerOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvCameraHintPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_hint_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Kamera Belakang • Arahkan ke QR Pairing / Kartu Siswa"
            android:textColor="#F1F5F9"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Panel Hasil Scan & Antrean Offline -->
    <LinearLayout
        android:id="@+id/footerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="#1E293B">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="11dp"
            android:background="@drawable/bg_result_card">

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Siap Memindai Kartu QR"
                android:textColor="#34D399"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvResultDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Scan QR Pairing di layar PC untuk koneksi otomatis 1 detik."
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvQueueInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Antrean offline: 0 scan"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFlushQueue"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Kirim Antrean"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
